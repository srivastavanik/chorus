NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
XAI_API_KEY=
BRAINTRUST_API_KEY=
ANTHROPIC_API_KEY=

# Braintrust tracing (all optional)
# Enable SDK wrapping so xAI/Anthropic calls are traced.
BRAINTRUST_ENABLE_SDK_WRAPPING=false
# Only set to true in environments approved to store raw prompts, model
# outputs, and uploaded file contents. When false (default), traced content
# is redacted to metadata before export.
BRAINTRUST_LOG_RAW_CONTENT=false
